# TechScroll AI Environment Configuration

# Backend Port
PORT=3001

# AI Provider Configuration (openai | claude)
# Leave placeholder or empty to use the built-in Deterministic AI Engine
AI_PROVIDER=openai
OPENAI_API_KEY=sk-placeholder-key
# ANTHROPIC_API_KEY=sk-ant-placeholder-key

# Supabase Credentials (optional for local in-memory DB)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Vite Frontend API Base
VITE_API_BASE_URL=http://localhost:3001/api
